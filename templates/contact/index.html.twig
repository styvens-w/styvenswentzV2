{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    <main class="contact">
        <div class="contact__other">
            <div class="contact__other__icon">
                {{ ux_icon('material-symbols:info-outline') }}
            </div>
            <p>
                Vous avez également la possibilité de me contacter directement par courriel à
                <a href="mailto:contact@styvens-wentz.fr">contact@styvens-wentz.fr</a>
                ou par téléphone au
                <a href="tel:0749486311">07 49 48 63 11</a>
                pour plus d'informations.
            </p>
        </div>

        <h1 class="contact__title">Formulaire de Contact</h1>

        {{ form_start(form) }}
            {{ form_widget(form) }}
        {{ form_end(form) }}
    </main>
{% endblock %}