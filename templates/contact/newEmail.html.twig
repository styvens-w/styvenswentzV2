<!DOCTYPE html>
<html>
<head>
    <title>Contact</title>
</head>
<body style="background-color: #393939; color: #c8c8c8; margin: 0; font-family: Arial, sans-serif;">

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">

    <h1 style="text-align: center">{{ contact.subject }}</h1>

    <div>
        <p style="margin-bottom: 15px">
            <span style="display: inline-block; font-weight: bold; width: 110px; text-decoration: underline">
                Nom :
            </span>
            {{ contact.firstname }}
        </p>

        <p style="margin-bottom: 15px">
            <span style="display: inline-block; font-weight: bold; width: 110px; text-decoration: underline">
                Prénom :
            </span>
            {{ contact.lastname }}
        </p>

        <p style="margin-bottom: 15px">
            <span style="display: inline-block; font-weight: bold; width: 110px; text-decoration: underline">
                Adresse mail :
            </span>
            {{ contact.email }}
        </p>
    </div>

    <div>
        <p style="display: inline-block; font-weight: bold; width: 110px; text-decoration: underline; margin: 0">
            Message :
        </p>
        <p style="margin-top: 10px">{{ contact.message }}</p>
    </div>
</div>
</body>
</html>