{% extends 'base.html.twig' %}

{% block title %}Activité {{ activity.id }}{% endblock %}

{% block body %}
    <h1>Activité {{ activity.id }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ activity.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ activity.name }}</td>
            </tr>
            <tr>
                <th>Entreprise</th>
                <td>{{ activity.compagny }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ activity.start ? activity.start|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ activity.end ? activity.end|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Diplôme</th>
                <td>{{ activity.degree }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_activity_edit', {'id': activity.id}) }}">Modifier</a>

    {{ include('activity/_delete_form.html.twig') }}

    <a href="{{ path('app_activity_index') }}">Retour à la liste</a>
{% endblock %}
