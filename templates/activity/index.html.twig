{% extends 'base.html.twig' %}

{% block title %}Activités{% endblock %}

{% block body %}
    <h1>Activités</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Entreprise</th>
                <th>Date de début</th>
                <th>Date de fin</th>
                <th>Diplôme</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for activity in activities %}
            <tr>
                <td>{{ activity.id }}</td>
                <td>{{ activity.name }}</td>
                <td>{{ activity.compagny }}</td>
                <td>{{ activity.start ? activity.start|date('Y-m-d') : '' }}</td>
                <td>{{ activity.end ? activity.end|date('Y-m-d') : '' }}</td>
                <td>{{ activity.degree }}</td>
                <td>
                    <a href="{{ path('app_activity_show', {'id': activity.id}) }}">Voir</a>
                    |
                    <a href="{{ path('app_activity_edit', {'id': activity.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucune activité trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_activity_new') }}">Créer une nouvelle activité</a>
{% endblock %}
