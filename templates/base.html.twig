<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Bienvenue!{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/favicon.ico') }}">

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>

    {% include '/base/header/_header.html.twig' %}

        {% for category, messages in app.flashes %}
            {% for message in messages %}
                <div class="information alert alert-{{ category }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}


        {% block body %}{% endblock %}


        {% include '/base/footer/_footer.html.twig' %}
    </body>
</html>
