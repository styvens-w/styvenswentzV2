<nav {{ attributes }} class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('admin_index') }}">
            <img src="{{ asset('images/others/profile.webp') }}" alt="logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_index') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a style="display: none" class="nav-link" href="{{ path('cv_index') }}">CV</a>
                </li>
                <li class="nav-item dropdown">
                    <a role="button" class="btn" href="{{ path('portfolio_index') }}">Portfolio</a>
                    <button type="button" class="btn dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu">
                        {% set grouped_projects = {} %}

                        {# Regrouper les activités par type #}
                        {% for project in this.projects %}
                            {% set type_name = project.activity.type.name %}
                            {% if grouped_projects[type_name] is not defined %}
                                {% set grouped_projects = grouped_projects | merge({ (type_name): [] }) %}
                            {% endif %}
                            {% if project.activity not in grouped_projects[type_name] %}
                                {% set grouped_projects = grouped_projects | merge({ (type_name): grouped_projects[type_name] | merge([project.activity]) }) %}
                            {% endif %}
                        {% endfor %}

                        {# Trier les types d'activités par ordre alphabétique #}
                        {% set sorted_types = grouped_projects | keys | sort %}

                        {% for type in sorted_types %}
                            <li><a class="dropdown-item disabled" aria-disabled="true" href="#">{{ type }}</a></li>
                            {% set displayed_activity_names = [] %}
                            {% for activity in grouped_projects[type] %}
                                {% if activity.name not in displayed_activity_names %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('portfolio_index_with_activity', { activityId: activity.id }) }}">
                                            {{ activity.name }}
                                        </a>
                                    </li>
                                    {% set displayed_activity_names = displayed_activity_names | merge([activity.name]) %}
                                {% endif %}
                            {% endfor %}
                            {% if not loop.last %}
                                <li><hr class="dropdown-divider"></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('contact_index') }}">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
