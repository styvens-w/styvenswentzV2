{% extends 'base.html.twig' %}

{% block title %}Activité {{ activity.id }}{% endblock %}

{% block body %}
    <main class="admin__show">
        <h1 class="admin__title">Activité {{ activity.id }}</h1>

        <div class="actions">
            <a class="actions__return" href="{{ path('app_activity_index') }}">Retour à la liste</a>
        </div>

        <table class="table">
            <tbody>
            <tr>
                <th>Id</th>
                <td>{{ activity.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ activity.name }}</td>
            </tr>
            <tr>
                <th>Entreprise</th>
                <td>{{ activity.compagny }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ activity.start|date('Y-m-d') }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ activity.end ? activity.end|date('Y-m-d') : 'En cours' }}</td>
            </tr>
            <tr>
                <th>Diplôme</th>
                <td>{{ activity.degree ? activity.degree : 'Sans diplôme' }}</td>
            </tr>
            <tr>
                <th>Actions</th>
                <td>
                    <div class="actions">
                        <a class="actions__edit" href="{{ path('app_activity_edit', {'id': activity.id}) }}">Modifier</a>
                        |
                        {{ include('admin/activity/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </main>

{% endblock %}
