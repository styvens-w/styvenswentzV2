{% extends 'base.html.twig' %}

{% block title %}Admin - New{% endblock %}

{% block body %}
    <main class="new">
        <h1 class="new__title">{{ title }}</h1>

        <section class="new__form">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit">{{ title }}</button>
            {{ form_end(form) }}
        </section>
    </main>
{% endblock %}