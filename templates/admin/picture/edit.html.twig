{% extends 'base.html.twig' %}

{% block title %}Modifier l'image{% endblock %}

{% block body %}
    <main class="admin__edit">
        <h1 class="admin__title">Modifier l'image</h1>

        <img style="width: 25%; height: 25%; margin-bottom: 20px" src="{{ vich_uploader_asset(picture) }}" alt="{{ picture.name }}">

        <div class="actions">
            <a class="actions__return" href="{{ path('app_picture_index') }}">Retour à la liste</a>
        </div>

        {{ include('admin/picture/_form.html.twig', {'button_label': 'Modifier'}) }}

        <div class="actions">
            {{ include('admin/picture/_delete_form.html.twig') }}
        </div>
    </main>
{% endblock %}
