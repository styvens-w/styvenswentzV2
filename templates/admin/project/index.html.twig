{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block body %}
    <main class="admin__index">
        <h1 class="admin__title">Projets</h1>

        <div class="actions">
            <a class="actions__return" href="{{ path('admin_index') }}">Retour à l'espace administration</a>
            <a class="actions__new" href="{{ path('app_project_new') }}">Créer un nouveau projet</a>
        </div>

        <table class="table">
            <thead>
            <tr>
                <th class="desktop">Id</th>
                <th>Nom</th>
                <th class="desktop">Date de début</th>
                <th class="desktop">Date de fin</th>
                <th class="desktop">Site</th>
                <th class="desktop">Github</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for project in projects %}
                <tr>
                    <td class="desktop">{{ project.id }}</td>
                    <td>{{ project.name }}</td>
                    <td class="desktop">{{ project.start ? project.start|date('d/m/Y') : '' }}</td>
                    <td class="desktop">{{ project.end ? project.end|date('d/m/Y') : '' }}</td>
                    <td class="desktop">{{ project.site }}</td>
                    <td class="desktop">{{ project.github }}</td>
                    <td>
                        <div class="actions">
                            <a class="actions__show" href="{{ path('app_project_show', {'slug': project.slug}) }}">Voir</a>
                            |
                            <a class="actions__edit" href="{{ path('app_project_edit', {'slug': project.slug}) }}">Modifier</a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8">Aucun projet trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </main>
{% endblock %}
