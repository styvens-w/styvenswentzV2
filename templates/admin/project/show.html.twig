{% extends 'base.html.twig' %}

{% block title %}Projet {{ project.id }}{% endblock %}

{% block body %}
    <main class="admin__show">
        <h1 class="admin__title">Projet {{ project.id }}</h1>

        <div class="actions">
            <a class="actions__return" href="{{ path('app_project_index') }}">Retour à la liste</a>
        </div>

        <table class="table">
            <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ project.name }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ project.start ? project.start|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ project.end ? project.end|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Site</th>
                <td>{{ project.site }}</td>
            </tr>
            <tr>
                <th>Github</th>
                <td>{{ project.github }}</td>
            </tr>
            <tr>
                <th>Technologies</th>
                <td>
                    {% for techno in project.technos %}
                        <span>{{ techno.name }} | </span>
                    {% else %}
                        <span>Aucune technologie pour ce projet</span>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Activité</th>
                <td>{{ project.activity.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ project.description }}</td>
            </tr>
            <tr>
                <th>Actions</th>
                <td>
                    <div class="actions">
                        <a class="actions__edit" href="{{ path('app_project_edit', {'id': project.id}) }}">Modifier</a>
                        |
                        {{ include('admin/project/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </main>
{% endblock %}
