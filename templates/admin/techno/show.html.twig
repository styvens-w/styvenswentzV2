{% extends 'base.html.twig' %}

{% block title %}Technologie {{ techno.id }}{% endblock %}

{% block body %}
    <main class="admin__techno__edit">
        <h1 class="admin__title">Technologie {{ techno.id }}</h1>

        <div class="actions">
            <a class="actions__return" href="{{ path('app_techno_index') }}">Retour à la liste</a>
        </div>

        <table class="table">
            <tbody>
            <tr>
                <th>Id</th>
                <td>{{ techno.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ techno.name }}</td>
            </tr>
            <tr>
                <th>Actions</th>
                <td>
                    <div class="actions">
                        <a class="actions__edit" href="{{ path('app_techno_edit', {'id': techno.id}) }}">Modifier</a>
                        |
                        {{ include('admin/techno/_delete_form.html.twig') }}
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </main>
{% endblock %}
