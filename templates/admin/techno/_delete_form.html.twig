<form class="form__delete" method="post" action="{{ path('app_techno_delete', {'id': techno.id}) }}"
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ techno.id) }}">
    <button class="btn actions__delete">Supprimer</button>
</form>
