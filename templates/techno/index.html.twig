{% extends 'base.html.twig' %}

{% block title %}Technologie{% endblock %}

{% block body %}
    <h1>Technologie</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for techno in technos %}
            <tr>
                <td>{{ techno.id }}</td>
                <td>{{ techno.name }}</td>
                <td>
                    <a href="{{ path('app_techno_show', {'id': techno.id}) }}">Voir</a>
                    |
                    <a href="{{ path('app_techno_edit', {'id': techno.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune technologie trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_techno_new') }}">Ajouter une nouvelle technologie</a>
{% endblock %}
