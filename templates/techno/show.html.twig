{% extends 'base.html.twig' %}

{% block title %}Technologie {{ techno.id }}{% endblock %}

{% block body %}
    <h1>Technologie {{ techno.id }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ techno.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ techno.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_techno_edit', {'id': techno.id}) }}">Modifier</a>

    {{ include('techno/_delete_form.html.twig') }}

    <a href="{{ path('app_techno_index') }}">Retour à la liste</a>
{% endblock %}
