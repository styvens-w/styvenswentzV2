{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block body %}
    <h1>Projets</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th style="width: 200px">Nom</th>
                <th>Date de début</th>
                <th>Date de fin</th>
                <th>Site</th>
                <th style="width: 200px">Github</th>
                <th style="width: 500px">Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.name }}</td>
                <td>{{ project.start ? project.start|date('Y-m-d') : '' }}</td>
                <td>{{ project.end ? project.end|date('Y-m-d') : '' }}</td>
                <td>{{ project.site }}</td>
                <td>{{ project.github }}</td>
                <td>{{ project.description }}</td>
                <td>
                    <a href="{{ path('app_project_show', {'id': project.id}) }}">Voir</a>
                    |
                    <a href="{{ path('app_project_edit', {'id': project.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Aucun projet trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_project_new') }}">Créer un nouveau projet</a>
{% endblock %}
