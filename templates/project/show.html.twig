{% extends 'base.html.twig' %}

{% block title %}Projet {{ project.id }}{% endblock %}

{% block body %}
    <h1>Projet {{ project.id }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ project.name }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ project.start ? project.start|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ project.end ? project.end|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Site</th>
                <td>{{ project.site }}</td>
            </tr>
            <tr>
                <th>Github</th>
                <td>{{ project.github }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ project.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_project_edit', {'id': project.id}) }}">Modifier</a>

    {{ include('project/_delete_form.html.twig') }}

    <a href="{{ path('app_project_index') }}">Retour à la liste</a>
{% endblock %}
