{% extends 'base.html.twig' %}

{% block title %}Portfolio{% endblock %}

{% block body %}
    <main class="portfolio">
        <h1 class="portfolio__title">Portfolio</h1>

        <section class="portfolio__cards">
            {% set displayedActivities = [] %}

            {% for project in projects %}

                {% set activityKey = project.activity.type.name ~ ' - ' ~ project.activity.name %}

                {% if activityKey not in displayedActivities %}

                    <h2 class="portfolio__cards__title">{{ activityKey }}</h2>
                    {% set displayedActivities = displayedActivities|merge([activityKey]) %}

                {% endif %}

            <div class="portfolio__cards__card">
                <a href="{{ path('portfolio_show', {id: project.id}) }}">
                    <div class="portfolio__cards__card__info">
                        <h3 class="portfolio__cards__card__info__title">{{ project.name }}</h3>

                        <p class="portfolio__cards__card__info__compagny">
                            {{ project.activity.compagny ? project.activity.compagny }}
                        </p>

                        <p class="portfolio__cards__card__info__activity">
                            {{ project.activity.type.name ==  'Formation' ? 'Formation ' : 'Activité ' }}
                            {{ project.activity.name }}
                            {{ project.activity.degree ? '(' ~ project.activity.degree ~ ')' }}
                        </p>

                        <p class="portfolio__cards__card__info__date">
                            Du {{ project.start|date('d/m/Y') }}
                            {{ project.end ? 'au ' ~ project.end|date('d/m/Y') : 'à maintenant' }}
                        </p>
                    </div>
                </a>
            </div>
            {% else %}
                <div class="portfolio__cards__info">
                    <p>Aucun projet trouvé.</p>
                </div>
            {% endfor %}
        </section>
    </main>
{% endblock %}