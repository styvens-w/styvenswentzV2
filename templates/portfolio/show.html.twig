{% extends 'base.html.twig' %}

{% block title %}Projet - {{ project.name }}{% endblock %}

{% block body %}
    <main class="project">
        <h1 class="project__title">{{ project.name }} </h1>
        <p class="project__subtitle">{{ project.close ? '(Le site n\'est pas en ligne ou l\'entreprise a fermé.)' }}</p>

        <a href="{{ path('portfolio_index') }}">Retourner vers le portfolio</a>

        <article class="project__card">
            {% if project.pictures|length > 0 %}
                <div id="carouselCaptions" class="project__card__carousel carousel slide">
                    <div class="carousel-inner">
                        {% for picture in project.pictures %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                <img src="{{ vich_uploader_asset(picture) }}" class="d-block w-100" alt="{{ project.name }}">
                            </div>
                        {% endfor %}
                    </div>

                    {% if project.pictures|length > 1 %}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselCaptions" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselCaptions" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    {% endif %}
                </div>
            {% endif %}

            <div class="project__card__info">
                <p class="project__card__info__compagny">
                    {{ project.activity.compagny ? project.activity.compagny }}
                </p>

                <p class="project__card__info__activity">
                    {{ project.activity.type.name ==  'Formation' ? 'Formation ' : 'Activité ' }}
                    {{ project.activity.name }}
                    {{ project.activity.degree ? '(' ~ project.activity.degree ~ ')' }}
                </p>

                <p class="project__card__info__date">
                    Du {{ project.start|date('d/m/Y') }}
                    {{ project.end ? 'au ' ~ project.end|date('d/m/Y') : 'à maintenant' }}
                </p>

                <p class="project__card__info__site">
                    <span>Site web :</span>
                    <span>
                        {% if project.site %}
                            {% if project.close %}
                                <span>Site fermé</span>
                            {% else %}
                                <a href="{{ project.site }}">Cliquez ici</a>
                            {% endif %}
                        {% else %}
                            Aucun
                        {% endif %}
                    </span>
                </p>

                <p class="project__card__info__github">
                    <span>Github :</span>
                    <span>
                        {% if project.github %}
                            <a href="{{ project.github }}">Cliquez ici</a>
                        {% else %}
                            Privé
                        {% endif %}
                    </span>
                </p>

                <p class="project__card__info__techno">
                    <span>Technologies utilisées :</span>
                    {% for techno in project.technos %}
                        <span>{{ techno.name }} | </span>
                    {% else %}
                        <span>Aucune technologie pour ce projet</span>
                    {% endfor %}
                </p>

                <div class="project__card__info__description">
                    <p>Description :</p>
                    <p>{{ project.description }}</p>
                </div>
            </div>
        </article>
    </main>
{% endblock %}