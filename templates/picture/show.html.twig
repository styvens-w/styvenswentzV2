{% extends 'base.html.twig' %}

{% block title %}Image {{ picture.id }}{% endblock %}

{% block body %}
    <h1>Image {{ picture.id }}</h1>

    <img style="width: 70%; height: 70%; margin: auto" src="{{ asset('images/projects/' ~ picture.name) }}" alt="{{ picture.name }}">

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ picture.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ picture.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_picture_edit', {'id': picture.id}) }}">Modifier</a>

    {{ include('picture/_delete_form.html.twig') }}

    <a href="{{ path('app_picture_index') }}">Retour à la liste</a>
{% endblock %}
